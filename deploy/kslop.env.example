# Configuration for the Leonida relay. Copy to /etc/kslop/kslop.env, keep it
# root-owned and mode 0600, and uncomment what you need. Referenced by
# deploy/kslop.service via EnvironmentFile=-/etc/kslop/kslop.env.
#
# The unit already sets working defaults for PORT and HOST; anything set here
# wins.

# Where the relay listens. It sits behind a proxy in another container, so it
# must be reachable on the host network.
#PORT=8080
#HOST=0.0.0.0

# A fixed city seed. Omit for a fresh city on every restart.
#SEED=20251008

# Secret required by GET /reload. If unset, the relay prints a fresh random one
# to the journal at startup:  journalctl -u kslop | grep -i token
#TOKEN=change-me

# The proxy's address as the relay sees it, so the per-address limit and
# /health use the real client instead of the proxy. Use the nginx container's
# address, or the docker network it lives on. Keep it as narrow as you can:
# a whole /12 trusts every container on every docker network.
#TRUSTED_PROXY=172.18.0.4
#TRUSTED_PROXY=172.16.0.0/12

# Connections allowed per client address (default 4).
#PER_IP_MAX=4

# New connections per second per address, and the burst allowance (defaults
# 5 and 20). Stops a connect/disconnect loop from flooding every player.
#CONN_RATE_PER_SEC=5
#CONN_RATE_BURST=20

# Bytes queued to one client before the relay drops it, in bytes
# (default 262144). Bun's own default is 16 MiB and never closes.
#BACKPRESSURE_LIMIT=262144
